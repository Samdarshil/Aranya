# Copy to .env and fill in. Never commit the real .env file.

# --- Database (production target; backend/memory/store.py falls back to
#     a local sqlite file at data/aranya.db if this is unset) -----------
DATABASE_URL=postgresql+psycopg2://aranya:changeme@localhost:5432/aranya

# --- LLM provider abstraction (spec section 6) --------------------------
# Not yet wired to any agent — no LLM call exists in the codebase yet
# (VisionAgent is fully deterministic). Set this when the orchestrator's
# intent-understanding layer is implemented.
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# --- External data providers (spec section 20) — none are called yet.
# Fill in when the corresponding agent (Weather, Market, Scheme) is built.
WEATHER_API_KEY=
MARKET_DATA_API_KEY=
# Voice (spec section 16) — not yet used by any tested code path beyond
# the orchestration logic (which is tested with a fake provider); the
# real Google Cloud Speech client is written but never executed.
GOOGLE_SPEECH_API_KEY=

# --- OTP delivery (spec section 19) ---------------------------------------
# Neither is required — with both unset, the login flow falls back to
# returning the code directly in the API response (dev-mode only; see
# backend/security/auth_service.py). Configure either or both for real
# delivery. Email delivery is genuinely tested end-to-end in this
# codebase (tests/test_email_delivery.py, real local SMTP server); SMS
# (Twilio) is written but has never been tested against a live account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@aranya.example
SMTP_USE_TLS=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Auth (spec section 19) — not yet implemented -----------------------
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256

# --- Storage (spec section 6) — scan images are not yet persisted to
# object storage; only their derived metrics are stored in Farm Memory.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/media
